# AURA-X server configuration. Replace placeholders in your own environment.
NODE_ENV=development
PORT=3000

# Provision a MySQL/MariaDB database in the destination project.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Managed server-side Manus LLM service (never expose to the browser).
MANUS_PROJECT_ID=YOUR_MANUS_PROJECT_ID
MANUS_API_URL=https://YOUR_MANUS_API_BASE
MANUS_API_KEY=YOUR_MANUS_SERVER_SIDE_API_KEY

# Optional server-side providers. Never place these in VITE_* variables.
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_SUBSCRIPTION_TOKEN
ELEVENLABS_API_KEY=
